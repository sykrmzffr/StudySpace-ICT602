<?xml version="1.0" encoding="utf-8"?>
<!--
    colors.xml — StudySpace Color Palette
    Based on Material Design 3. Using a blue/indigo primary scheme
    that feels professional and academic.
-->
<resources>
    <!-- Primary Brand Colors -->
    <color name="primary">#1565C0</color>           <!-- Deep Blue -->
    <color name="primary_dark">#0D47A1</color>       <!-- Darker Blue -->
    <color name="primary_light">#E3F2FD</color>      <!-- Light Blue tint -->
    <color name="primary_container">#D3E4FF</color>  <!-- MD3 primary container -->
    <color name="on_primary">#FFFFFF</color>

    <!-- Secondary / Accent -->
    <color name="secondary">#00897B</color>          <!-- Teal — for available status -->
    <color name="secondary_container">#C8F5F1</color>
    <color name="on_secondary">#FFFFFF</color>

    <!-- Surface / Background -->
    <color name="background">#F8FAFF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EEF2FB</color>
    <color name="on_surface">#1A1C22</color>
    <color name="on_surface_variant">#44475A</color>

    <!-- Status Colors -->
    <color name="available">#2E7D32</color>           <!-- Green — room available -->
    <color name="booked">#C62828</color>              <!-- Red — room booked -->
    <color name="pending">#F57F17</color>             <!-- Amber — pending -->

    <!-- Error -->
    <color name="error">#B00020</color>
    <color name="on_error">#FFFFFF</color>

    <!-- Text -->
    <color name="text_primary">#1A1C22</color>
    <color name="text_secondary">#6B6F85</color>
    <color name="text_hint">#9EA3B8</color>

    <!-- Legacy (required by some Material components) -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
