<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — StudySpace
    Declares all permissions, activities, and services for the app.
    Permissions are mapped to Tutorial topics:
        - INTERNET           → T04, T05, T06, T07 (all online features)
        - ACCESS_FINE_LOCATION → T08 (Google Maps navigation)
        - CAMERA             → T09 (QR code scanning)
        - POST_NOTIFICATIONS → T06 (FCM push notifications, Android 13+)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- T07 — Connectivity: Check internet availability -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- T08 — Maps: GPS location for navigation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- T09 — Camera: QR code check-in scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- T06 — Notifications: Firebase Cloud Messaging (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudySpace">

        <!-- ── Splash Screen ── -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.StudySpace.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── T05 — Authentication Screens ── -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Main App (hosts bottom nav + fragments) ── -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- ── T08 — Maps: Navigate to Room ── -->
        <activity
            android:name=".ui.maps.MapsActivity"
            android:exported="false" />

        <!-- ── T09 — Camera: QR Check-In ── -->
        <activity
            android:name=".ui.qr.QrCheckInActivity"
            android:exported="false" />

        <!-- ── Phase 3 — Room Detail & Booking ── -->
        <activity
            android:name=".ui.detail.RoomDetailActivity"
            android:exported="false" />

        <!-- T06 — Firebase Cloud Messaging Service -->
        <service
            android:name=".service.StudySpaceFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            NOTE: Add your Google Maps API Key in local.properties as:
            MAPS_API_KEY=YOUR_KEY_HERE
            Then reference it here using a Secrets Gradle Plugin, or paste directly below for testing.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDIDF_sPcKB7lGVuRWV4irKRrEFlsADfA4" />

    </application>

</manifest>
