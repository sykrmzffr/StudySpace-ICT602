<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <!-- Destination IDs match the bottom_nav_menu.xml IDs -->

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.studyspace.ui.home.HomeFragment"
        android:label="@string/study_rooms"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_my_bookings"
        android:name="com.example.studyspace.ui.bookings.MyBookingsFragment"
        android:label="@string/my_bookings"
        tools:layout="@layout/fragment_my_bookings" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.studyspace.ui.profile.ProfileFragment"
        android:label="@string/profile"
        tools:layout="@layout/fragment_profile" />

</navigation>
